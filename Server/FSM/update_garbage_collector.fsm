/*%FSM<COMPILE "scriptedFSM.cfg, update_garbage_collector.fsm">*/
/*%FSM<HEAD>*/
/*
item0[] = {"Start_FSM",0,250,-75.000000,0.000000,25.000000,50.000000,0.000000,"Start FSM"};
item1[] = {"Loop",4,218,-75.000000,-100.000000,25.000000,-50.000000,1.000000,"Loop"};
item2[] = {"Garbage_Collecto",2,4346,75.000000,-100.000000,175.000000,-50.000000,0.000000,"Garbage" \n "Collector"};
item3[] = {"Gameover",4,218,75.000000,-200.000000,175.000000,-150.000000,0.000000,"Gameover"};
item4[] = {"End_FSM",1,250,225.000000,-200.000000,325.000000,-150.000000,0.000000,"End FSM"};
link0[] = {0,1};
link1[] = {1,2};
link2[] = {2,1};
link3[] = {2,3};
link4[] = {3,4};
globals[] = {25.000000,1,0,0,0,640,480,1,129,6316128,1,-454.516235,362.175446,361.950592,-337.128723,760,636,1};
window[] = {0,-1,-1,-1,-1,881,100,1467,100,1,778};
*//*%FSM</HEAD>*/
class FSM
{
  fsmName = "update_garbage_collector.fsm";
  class States
  {
    /*%FSM<STATE "Start_FSM">*/
    class Start_FSM
    {
      name = "Start_FSM";
      init = /*%FSM<STATEINIT""">*/"_ncycle = time + 15;" \n
       "" \n
       "CTI_GarbageCollector = [];"/*%FSM</STATEINIT""">*/;
      precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
      class Links
      {
        /*%FSM<LINK "Loop">*/
        class Loop
        {
          priority = 1.000000;
          to="Garbage_Collecto";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"!CTI_GameOver && time > _ncycle "/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
      };
    };
    /*%FSM</STATE>*/
    /*%FSM<STATE "Garbage_Collecto">*/
    class Garbage_Collecto
    {
      name = "Garbage_Collecto";
      init = /*%FSM<STATEINIT""">*/"CTI_GarbageCollector = CTI_GarbageCollector - [objNull];" \n
       "" \n
       "if (count allDead > 200) then {" \n
       "{" \n
       "	if (!(_x in CTI_GarbageCollector) && isNil {_x getVariable ""cti_gc_noremove""}) then {" \n
       "		CTI_GarbageCollector pushback _x;" \n
       "		[_x] spawn CTI_SE_FNC_TrashObject;" \n
       "	};" \n
       "} forEach allDead;" \n
       "};" \n
       "" \n
       "private _svb_defTeams = [];" \n
       "{" \n
       "	private _side = _x;" \n
       "	private _lg = _side call CTI_CO_FNC_GetSideLogic;" \n
       "	if (!isNull _lg) then {" \n
       "		private _dt = _lg getVariable [""cti_defensive_team"", grpNull];" \n
       "		if (!isNull _dt) then {_svb_defTeams pushBack _dt};" \n
       "	};" \n
       "} forEach [west, east, resistance];" \n
       "" \n
       "private _svb_removed = 0;" \n
       "{" \n
       "	private _grp = _x;" \n
       "	if (!isNull _grp && {count (units _grp) isEqualTo 0}) then {" \n
       "		if (!(_grp call CTI_CO_FNC_IsGroupPlayable) && {!(_grp getVariable [""cti_defense_team"", false])} && {!(_grp getVariable [""cti_jip_preserve"", false])} && {!(_grp getVariable [""cti_player_disconnected"", false])} && {!(_grp in _svb_defTeams)}) then {" \n
       "			_svb_removed = _svb_removed + 1;" \n
       "			deleteGroup _grp;" \n
       "		};" \n
       "	};" \n
       "} forEach allGroups;" \n
       "" \n
       "if (_svb_removed > 0) then {diag_log format ["":: GC :: empty groups removed: %1"", _svb_removed]};" \n
       "" \n
       "_ncycle = time + 180;"/*%FSM</STATEINIT""">*/;
      class Links
      {
        /*%FSM<LINK "Loop">*/
        class Loop
        {
          priority = 1.000000;
          to="Garbage_Collecto";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"!CTI_GameOver && time > _ncycle "/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
        /*%FSM<LINK "Gameover">*/
        class Gameover
        {
          priority = 0.000000;
          to="End_FSM";
          precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
          condition=/*%FSM<CONDITION""">*/"CTI_GameOver"/*%FSM</CONDITION""">*/;
          action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
        };
        /*%FSM</LINK>*/
      };
    };
    /*%FSM</STATE>*/
    /*%FSM<STATE "End_FSM">*/
    class End_FSM
    {
      name = "End_FSM";
      init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
      precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
      class Links
      {
      };
    };
    /*%FSM</STATE>*/
  };
  initState="Start_FSM";
  finalStates[] =
  {
    "End_FSM"
  };
};
/*%FSM</COMPILE>*/